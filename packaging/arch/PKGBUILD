# Maintainer: CraftPulse contributors
pkgname=craftpulse-git
pkgver=0.4.1.r0
pkgrel=1
pkgdesc='Discord Rich Presence for the ArtCraft creative apps'
arch=('x86_64' 'aarch64')
url='https://github.com/egsk4/CraftPulse'
license=('MIT')
depends=('gtk3' 'libayatana-appindicator' 'webkit2gtk-4.1' 'xdotool')
makedepends=('cargo' 'git' 'pkgconf')
optdepends=('xorg-xprop: X11 window detection' 'xprintidle: X11 idle detection'
            'kdotool: KDE Plasma window detection'
            'dex: XDG autostart support for standalone window managers')
provides=('craftpulse')
conflicts=('craftpulse')
source=('craftpulse::git+https://github.com/egsk4/CraftPulse.git')
# VCS sources have no fixed archive checksum; Git supplies the source history.
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/craftpulse"
  local version
  version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -1)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}
prepare() {
  cd "$srcdir/craftpulse"
  cargo fetch --locked
}
build() {
  cd "$srcdir/craftpulse"
  cargo build --release --frozen
}
check() {
  cd "$srcdir/craftpulse"
  cargo test --frozen
}
package() {
  cd "$srcdir/craftpulse"
  install -Dm755 target/release/craftpulse "$pkgdir/usr/bin/craftpulse"
  install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/craftpulse.png"
  install -Dm644 packaging/arch/craftpulse.desktop "$pkgdir/usr/share/applications/craftpulse.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
